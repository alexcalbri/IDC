{
  "id": "mantenimiento_monday",
  "module": "mantenimiento",
  "displayName": "Importacion de mantenimiento desde monday",
  "description": "Importa tableros de monday al modulo Mantenimiento: como planes preventivos o como ordenes y proyectos. Lee el tablero con el token de la empresa, mapea sus columnas y trae subelementos, actualizaciones y archivos.",
  "version": "1.0.0",
  "minModuleVersion": "0.1.0",
  "source": { "type": "github", "url": "https://github.com/alexcalbri/idc/tree/0000000000000000000000000000000000000000/extensions/mantenimiento_monday" },
  "permissions": [
    "network.outbound:api.monday.com",
    "secrets.write",
    "mantenimiento.import.write"
  ],
  "settings": [],
  "migrations": ["migrations/V001__settings.sql"],
  "uninstall": { "options": [
    { "id": "import_history", "label": "Historial de importaciones de monday", "default": "delete" }
  ] }
}
